# Word Frontend Environment Variables (Vercel Free + Supabase Free)
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional Testnet RPC Overrides (public defaults are configured in src/config/blockchain.ts)
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Server-Only Supabase Edge Function Secrets (NEVER prefix with VITE_)
# VERIFF_API_KEY=your-veriff-station-api-key
# VERIFF_SHARED_SECRET=your-veriff-shared-secret-key
# VERIFF_BASE_URL=https://stationapi.veriff.com
# MUTUAL_TRUST_ATTESTATION_SECRET=your-hmac-sha256-attestation-secret


